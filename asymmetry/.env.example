# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
ASYMMETRY_DATABASE_URL=postgresql+psycopg2://asymmetry:asymmetry@localhost:5432/asymmetry

# --- LLM (optional) ---------------------------------------------------------
# Without a key the platform runs end-to-end using deterministic heuristics.
# Every result is then labelled "heuristic" so it is never mistaken for
# model reasoning.
ANTHROPIC_API_KEY=

ASYMMETRY_MODEL_CHEAP=claude-haiku-4-5-20251001
ASYMMETRY_MODEL_DEEP=claude-sonnet-5
ASYMMETRY_MODEL_JUDGE=claude-opus-5

# Hard ceiling per pipeline run. The run degrades to heuristics rather than
# overspending.
ASYMMETRY_MAX_COST_PER_RUN_USD=5.0
ASYMMETRY_MAX_LLM_CALLS_PER_RUN=400

# --- Sources ----------------------------------------------------------------
# true = synthetic corpus only (offline, hermetic). false = live public APIs.
ASYMMETRY_USE_MOCK_SOURCES=true
# The SEC requires a descriptive user agent with real contact details.
ASYMMETRY_USER_AGENT=AsymmetryEngine/0.1 (research; contact: you@example.com)
# Optional: raises the GitHub search rate limit.
GITHUB_TOKEN=

# --- API --------------------------------------------------------------------
ASYMMETRY_API_PORT=8000
ASYMMETRY_CORS_ORIGINS=http://localhost:3000
# When set, mutating endpoints require the X-API-Key header.
ASYMMETRY_API_KEY=
ASYMMETRY_RATE_LIMIT_PER_MINUTE=120
